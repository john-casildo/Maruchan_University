# ==============================================
# MARUCHAN UNIVERSITY - CONFIGURACIÓN DOCKER
# ==============================================

# PostgreSQL Database
POSTGRES_USER=maruchan_user
POSTGRES_PASSWORD=maruchan_pass_2024
POSTGRES_DB=maruchan_db
POSTGRES_PORT=5432

# Backend API
BACKEND_PORT=8000

# IMPORTANTE: Genera una clave secreta única con:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-key-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Almacenamiento de Archivos
STORAGE_DIR=/app/maruchan_storage
UPLOAD_DIR=/app/maruchan_storage/submissions
MATERIALS_DIR=/app/maruchan_storage/materials
MAX_UPLOAD_SIZE=52428800    # 50MB
MAX_MATERIAL_SIZE=104857600 # 100MB

# Frontend Streamlit
FRONTEND_PORT=8501
API_URL=http://backend:8000

# Entorno
ENVIRONMENT=development
DEBUG=True

# PgAdmin (Opcional)
PGADMIN_EMAIL=admin@maruchan.edu
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# CORS - Orígenes permitidos
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Logging
LOG_LEVEL=INFO